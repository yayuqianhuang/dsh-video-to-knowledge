{
  "id": "gen.chain-governance",
  "title": "链治理官",
  "version": "0.3.0",
  "tier": "combat",
  "subchains": ["gen.code-governance", "gen.chain-governance-research"],
  "intent": "定期（每周一 09:00 自动）与按需扫描 ajtc 链注册表与 skill 注册表，按「带AI打仗」四层治理模型识别重复意图、版本异常、验收门缺失，并给出优化与合并建议；下设代码治理子链 gen.code-governance（按 Agent 提示词优化理论课 lesson1 对代码项目做优化/排查/文档资产沉淀，详见 docs/agent-prompt-optimization-theory-homework-plan.md）。",
  "principle": [
    "战略层（人负责）：链的 intent / principle / acceptance 必须清晰回答为什么做、成功标准、禁区。",
    "建制层（制度与组织）：链必须有明确的 nodes 拓扑、budget、expect 契约、版本号规则。",
    "战术层（AI自主）：llm 节点按角色执行，fn 节点真实读盘，控制流由 gate/map/loop/chain 负责。",
    "裁决层（机器验收）：每条链必须通过 lint 五门体系（功能/静态/性能/安全/回归），结果由机器裁定。",
    "避免无限新增：发现 intent 重合的链必须给出合并建议，而不是放任重复建设。",
    "产品化层（PM 辅助）：创建/优化触发链前，须经产品经理客户调研及洞察（gen.chain-governance-research 子链）对『触发者=客户』做 5w2h 七维洞察，将触发链作为产品产出；调研不得编造客户场景/数据。"
  ],
  "acceptance": [
    "真实扫描 chains/ 与 skills/ 目录并产出清单。",
    "optimizationPlan 至少覆盖 3 项可执行优化。",
    "mergePlan 指出所有可合并的链组并说明合并方案。",
    "newSkillSuggestions 基于未覆盖目标域给出新增建议。",
    "产出符合各节点声明的输出契约（expect），无契约违例。",
    "若目标为创建/优化触发链，须走 customerInsight 节点（gen.chain-governance-research 子链）产出 $.customerInsight，且 evidenceBasis 非空（编造风险已阻断）。"
  ],
  "redlines": [
    "AI 不得单方定义或降低成功标准",
    "AI 不得伪造证据、编造数据或结果",
    "不得跳过任何验收门（review / assert / 回归）",
    "不得越出本链声明的作战边界，侵入不归本链管辖的系统或数据",
    "不得删除或覆盖运行证据与追踪记录"
  ],
  "boundaries": {
    "owns": "定期（每周一 09:00 自动）与按需扫描 ajtc 链注册表与 skill 注册表，按「带AI打仗」四层治理模型识别重复意图、版本异常、验收门缺失，并给出优化与合并建议。",
    "notOwns": [
      "战略目标与验收标准的设定（属人，AI 只能执行与追问）",
      "超出本链 intent 声明范围的系统、代码与数据",
      "删除 / 迁移 / 资金 / 对外承诺等不可逆动作的最终决策"
    ],
    "escalateTo": "战略层（人）—— 经 clarify 护栏发 clarify.block，由 bail 收口交回"
  },
  "budget": {
    "maxSteps": 12000,
    "maxLlmCalls": 1200,
    "maxTokens": 12000000,
    "maxWallMs": 60000000,
    "maxNodeRuns": 600
  },
  "regressionTests": [
    {
      "id": "RT-CHAIN-GO-1",
      "type": "happy",
      "input": "一个本链 intent 范围内、目标明确的正常请求",
      "expect": "链走完主干阶段并从 deliver 终止，output.completionPackage 字段齐全，evidence.hashes 非空",
      "rationale": "主路径必须可达终点，这是所有其他用例的前提"
    },
    {
      "id": "RT-CHAIN-GO-2",
      "type": "guard",
      "input": "空目标或只有一句无法执行的模糊话",
      "expect": "intake 判非法 → intake.invalid → bail 终止，不进入任何 llm 节点",
      "rationale": "垃圾输入不该烧预算"
    },
    {
      "id": "RT-CHAIN-GO-3",
      "type": "governance",
      "input": "含高危不可逆措辞的目标（如「删掉现有实现从零重写」）",
      "expect": "clarify 判为 (B) 并 emit clarify.block → bail 拦截；接真实模型时须拦住，mock 下因占位放行须以真实模型复验",
      "rationale": "护栏形同虚设是本框架最贵的失败模式"
    },
    {
      "id": "RT-CHAIN-GO-4",
      "type": "pm-research",
      "input": "创建/优化触发链目标（如「新建一条处理 xx 的触发链」）",
      "expect": "进入 customerInsight 节点（gen.chain-governance-research 子链）产出 $.customerInsight；若调研节点编造客户场景（evidenceBasis 为空或无来源断言），redlineGate 须拦截并交人复核；evidenceBasis 非空方可放行进入 clarify",
      "rationale": "产品化层：将触发链作为产品产出前必须过 PM 客户洞察门，且编造风险须被机器门阻断"
    }
  ],
  "nodes": [
    {
      "id": "intake",
      "kind": "fn",
      "title": "入口归一化",
      "use": "intake",
      "trigger": [
        {
          "on": "chain.start"
        }
      ],
      "in": {
        "raw": "$.input"
      },
      "out": "$.intake",
      "declares": [
        "intake.ready",
        "intake.invalid"
      ]
    },
    {
      "id": "boundaryDecide",
      "kind": "fn",
      "title": "边界自决门（节点化拍板）：可逆边界 AI 自批，破坏性升级人",
      "use": "boundaryDecide",
      "trigger": [
        {
          "on": "signal.intake.ready"
        }
      ],
      "out": "$.boundary",
      "emit": [
        "boundaryDecide.done"
      ],
      "declares": [
        "boundaryDecide.done",
        "decision.approved",
        "decision.escalate"
      ],
      "maxRuns": 1
    },
    {
      "id": "customerInsight",
      "kind": "chain",
      "title": "产品经理客户调研及洞察（将触发链作为产品·必跑阶段）",
      "role": "product-manager",
      "use": "gen.chain-governance-research",
      "pick": "customerInsight",
      "out": "$.customerInsight",
      "halt": false,
      "trigger": [
        {
          "on": "signal.boundaryDecide.done"
        }
      ],
      "declares": [
        "customerInsight.ok"
      ],
      "maxRuns": 1
    },
    {
      "id": "clarify",
      "kind": "llm",
      "title": "防误解护栏（高危意图澄清 · 不可逆动作交回人裁定）",
      "role": "intent-guard",
      "trigger": [
        {
          "on": "signal.customerInsight.ok"
        }
      ],
      "prompt": {
        "system": "你是一条 AI JSON 触发链上的执行单元（intent-guard / 防误解护栏）。\n只输出一个 JSON 对象。不要代码围栏，不要解释，不要寒暄。\n输出必须是统一信封格式：{\"meta\":{},\"data\":{},\"signals\":[],\"issues\":[]}。\n\n【你的职责】在链进入实质执行之前，澄清用户的真实意图，拦截「AI 单方执行不可逆高危动作」的风险。\n你不制定计划、不产出业务结果、不替人做战略决策。\n\n【高危意图清单】用户目标或约束中出现以下任一指向时，视为待澄清：\n- 删除 / 删库 / 清空数据\n- 推倒重写 / 从零重做 / 废弃现有实现\n- 数据迁移 / 不可逆变更\n- 资金 / 支付 / 对外承诺\n- 越权访问不属于本链边界的系统\n\n【三种判别】\n(A) 目标明确且不触及高危动作 → 直接放行。\n(A2) 触及高危措辞，但用户已明确声明「保留现有 / 不删 / 存量不动 / 平行新增」等可逆口径 → 放行，并在 note 中记录已确认的可逆口径。\n(B) 明确指向不可逆高危动作（真删除 / 真重写 / 真迁移 / 真付款），且没有人给出显式授权 → 拦截。\n\n【你的动作】\n- (A) / (A2) → emit \"clarify.done\"，data.verdict 写 \"pass\"，data.note 说明判别依据。\n- (B) → emit \"clarify.block\"，data.verdict 写 \"block\"；data.note 写明：该意图属不可逆高危动作，依「带 AI 打仗」四层治理须上交战略层（人）裁定，\n  并要求人在 boundaries / constraints 中显式授权（override）后方可继续。AI 不得单方决定执行。边界依据：本链声明的 $.boundaries。\n\n【判定尺度】措辞模糊时优先放行并在 note 标注「待人确认口径」；只有表述明确指向 (B) 才拦截。宁可多问一句，不可少拦一次。",
        "user": "【用户原始目标】\n{{$.intake.goal}}\n\n【原始输入】\n{{$.input}}\n\n【人定成功标准】\n{{$.intake.successCriteria}}\n\n【人定禁区】\n{{$.intake.boundaries}}\n\n【人定约束】\n{{$.intake.constraints}}\n\n判断上述输入属于 (A) 安全 / (A2) 高危措辞但口径可逆 / (B) 不可逆高危动作 中的哪一种。\n按判别结果在 signals 中 emit 对应信号（clarify.done 或 clarify.block），并在 data 中给出 verdict / intent / note。\n\n【产品经理客户洞察（客户=触发者，如已产出）】\n{{$.customerInsight}}"
      },
      "expect": {
        "type": "object",
        "properties": {
          "verdict": {
            "type": "string"
          },
          "intent": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "temperature": 0.1,
      "retry": {
        "max": 1,
        "onExhausted": "throw"
      },
      "out": "$.clarify",
      "emit": [
        "clarify.done"
      ],
      "declares": [
        "clarify.done",
        "clarify.block"
      ],
      "maxRuns": 2
    },
    {
      "id": "redlines",
      "kind": "fn",
      "title": "红线门：禁止 AI 越权 / 伪造 / 跳门 / 越界 / 丢证据",
      "use": "redlines",
      "trigger": [
        {
          "on": "signal.clarify.done"
        }
      ],
      "out": "$.redlines",
      "declares": [
        "redlines.pass",
        "redlines.fail"
      ],
      "maxRuns": 2
    },
    {
      "id": "bail",
      "kind": "fn",
      "title": "输入非法，提前终止",
      "use": "deliver",
      "trigger": [
        {
          "on": "signal.intake.invalid"
        },
        {
          "on": "signal.clarify.block"
        },
        {
          "on": "signal.redlines.fail"
        },
        {
          "on": "signal.decision.escalate"
        }
      ],
      "in": {
        "answer": null,
        "quality": {
          "aborted": true,
          "reason": "输入缺少可执行目标，或触碰红线 / 高危意图待人裁定"
        }
      },
      "out": "$.output",
      "halt": true,
      "declares": [
        "chain.end"
      ]
    },
    {
      "id": "scan.chains",
      "kind": "fn",
      "title": "扫描链注册表",
      "use": "chainRegistryScan",
      "trigger": [
        {
          "on": "signal.redlines.pass"
        }
      ],
      "in": {},
      "out": "$.chains",
      "emit": [
        "scan.chains.done"
      ],
      "declares": [
        "scan.chains.done"
      ]
    },
    {
      "id": "scan.skills",
      "kind": "fn",
      "title": "扫描技能注册表",
      "use": "skillRegistryScan",
      "trigger": [
        {
          "on": "signal.redlines.pass"
        }
      ],
      "in": {},
      "out": "$.skills",
      "emit": [
        "scan.skills.done"
      ],
      "declares": [
        "scan.skills.done"
      ]
    },
    {
      "id": "crosscheck",
      "kind": "fn",
      "title": "链×skill 确定性交叉核对（证据层）",
      "use": "governanceCrossCheck",
      "trigger": [
        {
          "on": "signal.scan.chains.done"
        },
        {
          "on": "signal.scan.skills.done"
        }
      ],
      "in": {
        "chains": "$.chains.chains",
        "skills": "$.skills.skills",
        "oversizeNodeCount": 18
      },
      "out": "$.crosscheck",
      "emit": [
        "crosscheck.done"
      ],
      "declares": [
        "crosscheck.done"
      ]
    },
    {
      "id": "assess",
      "kind": "llm",
      "title": "治理评估",
      "role": "governance-assessor",
      "trigger": [
        {
          "on": "signal.crosscheck.done"
        }
      ],
      "when": "len($.chains.chains) > 0 && len($.skills.skills) > 0",
      "prompt": {
        "system": "你是一条 AI JSON 触发链上的 governance-assessor（链治理官）。只输出一个 JSON 对象，不要代码围栏、不要解释。输出必须是统一信封格式 {meta,data,signals,issues}。data 必须满足：{summary:string, chainStats:object, skillStats:object, optimizationPlan:[{target,reason,action,priority}], mergePlan:[{candidates:[],reason,approach,priority}], newSkillSuggestions:[{skill,reason}]}。优先基于真实扫描数据给出建议，没有则明确说明无。",
        "user": "【目标】{{$.intake.goal}}\n【链清单（真实扫描）】{{$.chains.chains}}\n【技能清单（真实扫描）】{{$.skills.skills}}\n\n请按以下维度评估：\n1. 重复意图：哪些链的 intent 高度重合，应合并？\n2. 版本号异常：是否有链版本号不符合 v主.次.修 规则？\n3. 验收门缺失：哪些链没有 review/critic/test-executor/assert 等验证节点？\n4. 孤儿 skill：哪些 skill 没有对应链或长期未更新？\n5. 新增机会：基于现有链覆盖盲区，建议新增哪些 skill/链？\n\n输出 governance.assessed 信号。"
      },
      "expect": {
        "type": "object",
        "required": [
          "summary",
          "optimizationPlan",
          "mergePlan"
        ],
        "properties": {
          "summary": {
            "type": "string"
          },
          "chainStats": {
            "type": "object"
          },
          "skillStats": {
            "type": "object"
          },
          "optimizationPlan": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "target",
                "reason",
                "action"
              ],
              "properties": {
                "target": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "action": {
                  "type": "string"
                },
                "priority": {
                  "type": "string"
                }
              }
            }
          },
          "mergePlan": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "candidates",
                "reason",
                "approach"
              ],
              "properties": {
                "candidates": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "reason": {
                  "type": "string"
                },
                "approach": {
                  "type": "string"
                },
                "priority": {
                  "type": "string"
                }
              }
            }
          },
          "newSkillSuggestions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "skill",
                "reason"
              ],
              "properties": {
                "skill": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "out": "$.assessment",
      "emit": [
        "governance.assessed"
      ],
      "declares": [
        "governance.assessed"
      ],
      "maxRuns": 4
    },
    {
      "id": "review",
      "kind": "llm",
      "title": "评审治理报告",
      "role": "critic",
      "trigger": [
        {
          "on": "signal.governance.assessed"
        },
        {
          "on": "signal.revise.done"
        }
      ],
      "prompt": {
        "system": "你是 critic。严格评审 governance-assessor 的产出，给出 0-1 分与具体缺陷。只输出 JSON 信封 {meta,data,signals,issues}，data 必须含 {score,weaknesses,suggestions}。",
        "user": "【目标】{{$.intake.goal}}\n【治理评估】{{$.assessment}}\n\n评审要求：\n1. optimizationPlan 是否基于真实扫描数据？\n2. mergePlan 是否有明确候选链与合并方案？\n3. 建议是否可执行、优先级是否清晰？\n4. 有没有遗漏的明显重复或明显缺口？"
      },
      "expect": {
        "type": "object",
        "required": [
          "score",
          "weaknesses"
        ],
        "properties": {
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "strengths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "weaknesses": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "where",
                "severity",
                "msg"
              ],
              "properties": {
                "where": {
                  "type": "string"
                },
                "severity": {
                  "type": "string"
                },
                "msg": {
                  "type": "string"
                }
              }
            }
          },
          "suggestions": {
            "type": "array"
          }
        }
      },
      "out": "$.review",
      "appendTo": "$.reviewHistory",
      "emit": [
        "review.done"
      ],
      "declares": [
        "review.done"
      ],
      "maxRuns": 3
    },
    {
      "id": "qualityGate",
      "kind": "gate",
      "title": "质量闸门",
      "trigger": [
        {
          "on": "signal.review.done"
        }
      ],
      "cases": [
        {
          "when": "$.review.score >= 0.85",
          "emit": "quality.pass",
          "label": "达标",
          "reason": "评分达到 0.85"
        },
        {
          "when": "len($.reviewHistory) >= 2",
          "emit": "quality.exhausted",
          "label": "轮次耗尽",
          "reason": "已迭代 2 轮，强制收敛"
        },
        {
          "when": "empty($.review.weaknesses)",
          "emit": "quality.pass",
          "label": "无缺陷",
          "reason": "评审未发现缺陷"
        }
      ],
      "default": "quality.fail",
      "declares": [
        "quality.pass",
        "quality.exhausted",
        "quality.fail"
      ]
    },
    {
      "id": "revise",
      "kind": "llm",
      "title": "定向修订",
      "role": "patcher",
      "trigger": [
        {
          "on": "signal.quality.fail"
        },
        {
          "on": "signal.critique.hasIssues"
        }
      ],
      "prompt": {
        "system": "你是 patcher。只修评审明确指出的问题，逐条回应。不同意的放进 rejected 并说明理由。输出 JSON 信封 {meta,data,signals,issues}，data 必须含 {patched,applied,rejected}。",
        "user": "【原评估】{{$.assessment}}\n【评审意见】{{$.review}}\n\n请修订 governance-assessor 的产出，直接输出修订后的 assessment 对象。"
      },
      "expect": {
        "type": "object",
        "required": [
          "patched"
        ],
        "properties": {
          "patched": {
            "type": "object"
          },
          "applied": {
            "type": "array"
          },
          "rejected": {
            "type": "array"
          }
        }
      },
      "out": "$.revised",
      "emit": [
        "revise.done"
      ],
      "declares": [
        "revise.done"
      ],
      "maxRuns": 2
    },
    {
      "id": "evidence",
      "kind": "fn",
      "title": "证据层军报：归档原始产物 + Hash + 可重跑命令（机器出，不可编造）",
      "use": "evidence",
      "trigger": [
        {
          "on": "signal.quality.pass"
        },
        {
          "on": "signal.quality.exhausted"
        }
      ],
      "out": "$.evidence",
      "emit": [
        "evidence.done"
      ],
      "declares": [
        "evidence.done"
      ],
      "in": {
        "artifacts": {
          "scan.chains": "$.chains",
          "scan.skills": "$.skills",
          "assess": "$.assessment",
          "review": "$.review",
          "revise": "$.revised",
          "crosscheck": "$.crosscheck"
        }
      }
    },
    {
      "id": "assert",
      "kind": "fn",
      "title": "交付前独立断言（机器门，不接受 AI 自证）",
      "use": "assert",
      "trigger": [
        {
          "on": "signal.evidence.done"
        }
      ],
      "in": {
        "conditions": [
          {
            "expr": "$.redlines.passed == true",
            "msg": "红线门未通过",
            "where": "redlines",
            "severity": "critical"
          },
          {
            "expr": "$.evidence != null",
            "msg": "证据包未生成",
            "where": "evidence",
            "severity": "high"
          },
          {
            "expr": "len($.evidence.hashes) >= 1",
            "msg": "证据 Hash 为空，产出无法验真",
            "where": "evidence",
            "severity": "medium"
          },
          {
            "expr": "$.review.score >= 0.6",
            "msg": "质量评分低于交付门槛 0.6",
            "where": "review",
            "severity": "medium"
          },
          {
            "expr": "coalesce($.revised.patched, $.assessment) != null",
            "msg": "主产出为空",
            "where": "deliver.answer",
            "severity": "high"
          }
        ]
      },
      "out": "$.assert",
      "declares": [
        "assert.passed",
        "assert.failed"
      ]
    },
    {
      "id": "deliver",
      "kind": "fn",
      "title": "收敛交付（叙述层 + 证据层 + 完成包）",
      "use": "deliver",
      "trigger": [
        {
          "on": "signal.assert.passed"
        },
        {
          "on": "signal.assert.failed"
        }
      ],
      "in": {
        "answer": {
          "summary": "=coalesce($.revised.patched.summary, $.assessment.summary, \"见 facts\")",
          "chainStats": "$.assessment.chainStats",
          "skillStats": "$.assessment.skillStats",
          "optimizationPlan": "$.assessment.optimizationPlan",
          "mergePlan": "$.assessment.mergePlan",
          "newSkillSuggestions": "$.assessment.newSkillSuggestions",
          "facts": "$.crosscheck",
          "revision": "$.revised.patched"
        },
        "artifacts": {
          "chains": "$.chains",
          "skills": "$.skills",
          "assessment": "$.assessment",
          "review": "$.review",
          "crosscheck": "$.crosscheck"
        },
        "quality": "$.review",
        "completionPackage": {
          "scope": "链仓治理覆盖度审查与整改建议",
          "changeScope": "本次运行实际触达的节点与产物见 artifacts；未触达的分支不在本次交付范围内。",
          "designRationale": "四层治理骨架：战略层由链头 intent/principle/acceptance/redlines/boundaries 固定；建制层由 trigger 拓扑 + budget + maxRuns 约束；战术层 AI 在边界内执行，越界经 clarify 交回人；裁决层由 redlines / review / evidence / assert 四道机器门判定，不接受 AI 自证。",
          "risks": "$.review.weaknesses",
          "acceptanceCommand": "=\"node src/cli.js run gen.chain-governance --goal \\\"\" + coalesce($.intake.goal, \"\") + \"\\\"\"",
          "verificationResults": "$.evidence.gates",
          "regressionCompatibility": "链头 regressionTests 共 0 条；治理基线注入只新增护栏与证据节点、不改变原有阶段语义，回归口径不变。",
          "issuesAndMethods": "$.assert.issues",
          "openItems": "$.review.suggestions",
          "nextSteps": [
            "按 review 指出的 weaknesses 逐条修复后重跑",
            "若本次有未完成项（openItems），先补足再进入下一阶段",
            "用 gen.chain-governance 定期审查本链治理覆盖度"
          ],
          "artifactsHash": "=$.evidence.hashes",
          "narrative": {
            "layer": "叙述层（AI 写给人看）",
            "note": "以下由模型总结，供人快速决策：干了什么、卡在哪、需要你定什么。可读性优先，不作为验收依据。",
            "summary": "=coalesce($.revised.patched, $.review.summary, \"见 answer\")"
          },
          "evidence": {
            "layer": "证据层（机器统计，不可编造）",
            "note": "以下全部由 fn 节点确定性生成，模型无法改写；验收以本层为准。",
            "runId": "$.evidence.runId",
            "command": "$.evidence.command",
            "gates": "$.evidence.gates",
            "hashes": "=$.evidence.hashes",
            "assertions": "$.assert"
          }
        }
      },
      "out": "$.output",
      "halt": true,
      "declares": [
        "deliver.done",
        "chain.end"
      ]
    }
  ]
}
