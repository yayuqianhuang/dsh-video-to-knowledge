# AJTC 引擎环境变量示例（复制到 engine/.env 或注入到 dsh 进程环境）
# 本插件仅内置离线 mock 模型（确定性、可复现、零外部依赖），无需任何 API Key 即可验证链路。

# —— 记忆系统（可选，用户自选后端）——
# 记忆后端：memory-fns 支持两种后端，由 MEMORY_BACKEND 切换：
#   local      → 本地 JSON 文件存储（默认，开箱即用，零外部依赖）
#   tencentdb  → 远程 TencentDB Agent-Memory MemoryCore（蒸馏后端，不可达时优雅降级）
MEMORY_BACKEND=local

# TencentDB Agent-Memory MemoryCore 端点（MEMORY_BACKEND=tencentdb 时生效；不可达时优雅降级，不影响链运行）
MEMCORE_BASE_URL=http://127.0.0.1:8420
# MemoryCore 访问密钥（可选，视部署方要求）
MEMCORE_API_KEY=

# 本地后端存储目录（MEMORY_BACKEND=local 时生效；默认 engine/.runtime/memory）
# MEMORY_LOCAL_DIR=./.runtime/memory

# —— 影子回放录制目录（可选，覆盖默认 engine/run-shadow）——
# 安装到只读 node_modules 时务必指向可写目录
AJTC_SHADOW_DIR=./.runtime/shadow
